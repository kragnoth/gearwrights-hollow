  "variation": {
    "_comment": "World-space variation (0.14): each block picks one of its set's 'variants' (clean -> grimy) from smooth noise of 'scale' blocks plus 'jitter' per block, so neighbours are similar but never identical. 'grime' darkens block corners by 3D world noise, so soot shading flows across block edges. Raise grime.strength / a set's variant_spread for more contrast between clean and dirty patches.",
    "scale": 8,
    "jitter": 0.35,
    "grime": {
      "strength": 0.1,
      "scale": 10,
      "coverage": 0.45,
      "color": "#1f2324"
    }
  },
  "_haunt": "Haunted groves reuse the 'blight' mechanism: 2D x/z noise so a whole tree agrees; 'percent' of the world's area, 'scale' = grove size in blocks. Keep percent/scale identical on the log, leaf and flower rules.",
  "ghosts": {
    "_comment": "Client-only spectres in the haunted groves: random mobs from the pack, never added to the world (nothing can see, target or hit them). They only phase in while you look toward them (view_angle degrees either side of the crosshair, within radius, with line of sight) and phase out when you look away or they drift out of a grove. percent/scale must match the haunt values on the tree rules so they live in the same groves. mobs: ids, globs or #entity_type_tags to allow (default all; here every undead mob in the pack - mods that tag their undead #minecraft:undead join automatically); land_only drops flyers and swimmers; exclude: ids; categories: monster/creature/ambient.",
    "percent": 18,
    "scale": 18,
    "max": 6,
    "spawn_every": 95,
    "radius": 48,
    "min_distance": 10,
    "view_angle": 40,
    "line_of_sight": true,
    "alpha": 0.38,
    "flicker": 0.25,
    "fade_ticks": 25,
    "tint": "#b3ecff",
    "mobs": [
      "#minecraft:undead"
    ],
    "land_only": true,
    "categories": [
      "monster",
      "creature",
      "ambient"
    ],
    "exclude": [
      "minecraft:ender_dragon",
      "minecraft:wither",
      "minecraft:warden",
      "minecraft:giant",
      "minecraft:elder_guardian"
    ]
  },
  "ambience": {
    "_comment": "Client-only sound tied to the haunt zone (the ghosts' percent/scale). loops follow how deep you stand in a grove; duck_on_ghost cuts that loop the moment a ghost phases in. The ghost broadcasts (tools/gen_occult_radio.py, from FDR's public-domain 1933 Fireside Chat, scrambled past recognition) work the same way. phrases + gap_seconds: play one phrase at a time (never the same twice running) with a random silence between. oneshots play a few blocks around you. midnight: at 18000 day time the bell tolls, then ghosts may walk anywhere (and twice as many) for ghost_surge_seconds. All sounds are synthesised (tools/gen_occult_audio.py), loudness-matched with peaks limited so nothing spikes in headphones, and play under the Ambient/Environment volume slider.",
    "depth_radius": 10,
    "fade_seconds": 3,
    "loops": [
      {
        "sound": "occult:grove.crackle",
        "volume": 0.7
      },
      {
        "sound": "occult:grove.hum",
        "volume": 0.7
      },
      {
        "phrases": [
          "occult:grove.waltz1",
          "occult:grove.waltz2",
          "occult:grove.waltz3",
          "occult:grove.waltz4",
          "occult:grove.waltz5"
        ],
        "gap_seconds": [
          30,
          120
        ],
        "volume": 0.7,
        "duck_on_ghost": true
      },
      {
        "phrases": [
          "occult:grove.radio1",
          "occult:grove.radio2",
          "occult:grove.radio3",
          "occult:grove.radio4"
        ],
        "gap_seconds": [
          45,
          150
        ],
        "volume": 0.8,
        "duck_on_ghost": true
      }
    ],
    "oneshots": [
      {
        "sound": "occult:grove.whisper",
        "volume": 0.7,
        "per_minute": 2.5,
        "min_depth": 0.5
      }
    ],
    "midnight": {
      "sound": "occult:bell",
      "volume": 0.8,
      "tolls": 12,
      "interval_seconds": 3.2,
      "ghost_surge_seconds": 60
    }
  },
  "smoke_columns": {
    "_comment": "Distant foundry smoke on the horizon - always just inside the fog, dissolving as you approach. One chance per 'cell' x 'cell' blocks; puffs use the vanilla campfire smoke sprites, so the resource pack styles them. wind = direction in degrees, lean = how far the plume bends with it.",
    "density": 0.45,
    "cell": 112,
    "height": 110,
    "width": 12,
    "rise": 1.4,
    "puffs": 64,
    "wind": 25,
    "lean": 0.45,
    "max_distance": 180,
    "color_low": "#24211e",
    "color_high": "#5c5b5f",
    "ember": "#7a2e10"
  },
  "sky_omens": {
    "_comment": "Client-only omens over the vanilla sky; each in-game day rolls at most one from a hash of the day number, so every player sees the same one. smog_sun: dull orange sun, sepia day. twin_suns (The King in Yellow, 1895): a second pale sun sets beside the real one, then black stars rise and a small second moon circles the moon. eclipse: the sun goes black for duration_seconds; at totality ghosts walk everywhere and the grove ambience plays wherever you are. Set \"force\": \"eclipse\" (or smog_sun / twin_suns / none) to test.",
    "textures_namespace": "occult",
    "smog_sun": {
      "chance": 0.3,
      "color": "#b8652e",
      "cover": 0.92,
      "day_tint": "#ebd8bd"
    },
    "twin_suns": {
      "chance": 0.06,
      "offset": 11,
      "lag": 4,
      "alpha": 0.6,
      "black_stars": 40,
      "second_moon": true
    },
    "eclipse": {
      "chance": 0.025,
      "duration_seconds": 150,
      "darken": 0.72,
      "ghost_surge": true,
      "music": true
    }
  },
  "rules": [
    {
      "_comment": "The Nether keeps its fungus wood.",
      "if": {
        "id_contains": [
          "crimson",
          "warped"
        ]
      },
      "then": "keep"
    },
    {
      "_comment": "Already on theme - left exactly as made.",
      "if": {
        "namespace": "rustandrebar"
      },
      "then": "keep"
    },
    {
      "if": {
        "namespace": "rustandrebar_blocks"
      },
      "then": "keep"
    },
    {
      "if": {
        "namespace": "tarbound"
      },
      "then": "keep"
    },
    {
      "_comment": "Create's brass, copper and andesite machinery stays as made.",
      "if": {
        "namespace": "create"
      },
      "then": "keep"
    },
    {
      "_comment": "Tar wells up through the mud.",
      "if": {
        "blocks": [
          "minecraft:mud",
          "minecraft:muddy_mangrove_roots"
        ],
        "full_cube": true
      },
      "then": "swap",
      "standin": "tar_pool",
      "name": "Tar-soaked %s"
    },
    {
      "_comment": "Built-in dead forms (dead coral...).",
      "then": "native",
      "template": "{namespace}:dead_{path}",
      "name": "Dead %s"
    },
    {
      "_comment": "Flowers: the odd wisp bloom in the open, mostly wisp blooms in haunted groves. 'self' keeps the real flower.",
      "if": {
        "blocks": [
          "#minecraft:small_flowers",
          "#minecraft:tall_flowers"
        ],
        "occludes": false,
        "not_blocks": [
          "minecraft:wither_rose"
        ]
      },
      "then": "plant",
      "visible_percent": 100,
      "standins": [
        {
          "id": "self",
          "weight": 88
        },
        {
          "id": "wisp_bloom",
          "weight": 12
        }
      ],
      "tall": {
        "id": "self",
        "chance": 90
      },
      "blight": {
        "percent": 18,
        "scale": 18,
        "visible_percent": 100,
        "standins": [
          {
            "id": "wisp_bloom",
            "weight": 65
          },
          {
            "id": "self",
            "weight": 35
          }
        ],
        "tall": {
          "id": "self",
          "chance": 60
        }
      }
    },
    {
      "_comment": "Crops: every growth stage stays readable.",
      "if": {
        "blocks": [
          "#minecraft:crops"
        ],
        "occludes": false,
        "not_namespaces": [
          "create",
          "framedblocks",
          "copycats",
          "chipped_framed",
          "sophisticatedstorage",
          "sophisticatedbackpacks"
        ]
